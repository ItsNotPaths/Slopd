# Slopd config — simple `key: value`, '#' comments. A '#' starts a comment at the start of
# a line or after a space; glued to text (`foo#bar`) it is just part of the value. Editing a
# setting from the Config pane (`:cf`) rewrites its line here and leaves its comment alone.
#
# THIS FILE IS BAKED INTO THE BINARY. What you are reading is either that copy — the defaults
# Slopd reads before it reads yours — or the one `slopd --install` wrote out from it. There is
# no third version, which is why a value here and the behaviour of a binary with no config
# file cannot drift apart. **Slopd never creates this file on its own.** A downloaded binary
# runs on these defaults and cannot save a change until you install it.
#
# WHERE YOUR COPY LIVES depends on where the binary does. Beside it while Slopd is portable
# (a build folder), together with themes/, grammars/ and perf.log — move the folder and its
# whole world moves with it. Once `slopd --install` has made a copy at ~/.local/bin/slopd,
# this file is ~/.config/slopd/slopd.config and the rest is under ~/.local/share/slopd. Either
# way there is ONE directory per kind of file, no search path, and no setting here can point
# outside them. `slopd --where` says which is in force.
#
# `theme` is a NAME, never a path. `default` is the Gruvbox palette baked into the binary.
# `omarchy` follows the desktop: Slopd reads the palette Omarchy keeps at
# ~/.local/state/omarchy/current/theme/colors.toml, so `omarchy theme set` retints Slopd on
# its next start. That name is reserved and the Config pane offers it only on a machine that
# has a theme applied. Any OTHER name is themes/<name>.theme, a folder YOU create and drop
# .theme files (Prawk's format) into. It ships empty because the default is already inside
# the binary. A value with a '/' in it is refused, and the default stands.
theme: default

indent: spaces4        # tab | spaces2 | spaces4 | spaces8 ...
line_numbers: relative # global | relative
jump_lines: 10         # lines Ctrl+Up/Down jumps in the editor

# How every line view tracks what it follows — the editor its caret, and the filetree /
# grep / config lists their selection. follow: the view sits still
# until the target would leave it, then moves the minimum. middle: the target is pinned to
# the pane's middle row, so Up/Down always move the CONTENT under a fixed row (clamped at
# the top — there is nothing above row 0 to show). In the editor, "the target" is the FIRST
# (topmost) cursor.
scroll_mode: follow   # follow | middle

# Editor reading-aids (all default on; toggle in the Config pane too).
whitespace: on        # on | off — ghost leading-space dots / tab marks
indent_guides: on     # on | off — indent guides + the active-scope rail
folding: on           # on | off — Ctrl+Enter collapses blocks

# Command-line staging: a UI action that builds a CL command can stage it (you review
# and press Enter) or run it immediately.
folder_cd: stage      # stage | run — filetree Alt+Enter on a folder: cd to set the root

# Live preview: a builtin line SHOWS you what it would do while you are still typing it.
#   :j 240      the view moves to line 240 as you type the number
#   :f thing    every `thing` on the page is marked, the caret sits on the nearest one, and
#               Up/Down cycle them (with a query up they cycle results instead of history)
# Enter keeps where it took you and clears the marks. Esc puts the view back exactly as it was —
# the caret, the multi-cursor trail, and both scroll positions. Nothing is edited either way.
# A `:j <file>` does NOT preview: finding the file means walking the project, which is too much
# work for a keystroke. off: the line does nothing until you press Enter.
cl_preview: on        # on | off

# Enter (or a double click) on a BINARY or a SCRIPT in the file pane runs it instead of
# opening it — a program is not a document, and its bytes in the editor help nobody. This is
# the session it runs in, surfaced so you see the output; a number past the last open session
# opens the next one. Ctrl+O opens the file in the editor anyway, and Shift+Enter still stages
# the run command in the command line for when you want to type arguments onto it.
run_term: 1           # 1-99 — which terminal session an activated program runs in

# ^C IS COPY EVERYWHERE, and no longer a setting. At a focused terminal it copies that
# terminal's selection; with nothing selected there is no copy to make, so the key falls through
# to the job as the interrupt. ^Shift+C copies too. ^V pastes into the terminal, so a literal
# ^V never reaches the shell.

# Git. Slopd has no git pane: Alt+G (or the `:gs` builtin) hands the project root to
# whatever tool you already use, as its last argument. Unset, Alt+G opens a plain shell
# at the root instead.
#
# git_term decides where it runs, because the two kinds of tool want opposite things:
#   unset / 0   spawn it DETACHED, with its own window and no terminal — for a GUI
#               (sublime_merge, gitkraken, gitg). It outlives Slopd.
#   a number    run it in that terminal session — for a TUI (lazygit, tig, gitui), which
#               wants a PTY and a pane to live in. A number past the last open session
#               opens the next one: ask for 8 with three open and you get the fourth.
#
# In the Config pane git_tool is a TEXT field — highlight the row and type; Enter (or moving
# off the row) saves it. git_term is a dropdown of the sessions a launch can reach, and writes
# `detached` where this file leaves the value empty.
#
# One limit on the text field: a '#' after a space starts a comment in this file, so the pane
# refuses a value containing one rather than saving something that would read back truncated.
# `foo#bar` (glued, no space) is fine — that '#' is part of the value.
git_tool: lazygit     # e.g. lazygit — or `sublime_merge -n`, flags and all
git_term:             # e.g. 2 — empty (or `detached`) spawns it detached

# When the open file changes on disk while you have unsaved edits. prompt: report it and wait
# for you. keep: the relaxed mode — silently keep your edits, and stop reporting it. (A clean
# buffer always auto-reloads either way, in both modes.)
disk_conflict: prompt  # prompt | keep

# How `prompt` reports it. on: stage a `:reload ` command in the command line, ready for you to
# finish — `:reload y` (re-read, lose your edits), `:reload n` (keep mine, stop asking until the
# file changes again), or clear the line and type `:w` to make your version the one on disk.
# off: stage nothing and stay out of the way. Either way the modeline says so: the `*` in front
# of the file name becomes a `!` until you settle it.
conflict_stage: on     # on | off

# Pointer input. Additive only — everything the mouse reaches has a key binding, so `off`
# costs convenience and never capability. The wheel scrolls whatever is UNDER the cursor,
# focused or not, and it never moves focus:
#   editor    the view, freely — scrolling DETACHES it from the caret (in both scroll_modes)
#             and the next keystroke re-attaches, snapping back to wherever you were typing
#   terminal  the view, the same way. A wheel never moves the copy cursor. If the program
#             running in it asked for the mouse, or took the full screen, the notch is ITS
#             scroll instead — hold Shift to keep it local and scroll our scrollback.
#   image     zoom, about the pointer: the pixel under the cursor stays under the cursor
#   lists     filetree / grep / config: the view, detaching from the selection
#             exactly as the editor detaches from the caret. The next keystroke in that pane
#             re-attaches and the list jumps back to whatever is selected. In the file pane
#             (either face) the view EASES to where it is going, as the editor's does, rather
#             than snapping a row at a time — the wheel, the arrows and a click all ride it —
#             and a notch there moves ONE row rather than three, because a row is a whole
#             file (and in the grid, a whole row of tiles).
#
# Clicks. In the editor: click places the caret, Shift+click extends, Alt+click drops a
# cursor, double-click takes the word, triple-click the line, and a click on a fold's ...
# marker expands it. In a list: click selects, double-click opens. In a terminal: the same
# three grades of selection, unless the program asked for the mouse, in which case the click
# is forwarded to it — Shift keeps it local. A bare modifier is not a keystroke, so holding
# Alt leaves the cursor on screen to aim with.
#
# Dragging. Press and drag extends a selection by whatever the press chose (character, word
# or line), and keeps extending past the edge of the pane, scrolling as it goes. Drag the
# 2px divider between the panes to resize the split; a click on it does nothing. Drag an
# image to pan it, and double-click one to fit it back into the pane.
#
# CLICKING A PANE FOCUSES IT — the arrows follow your click, and the click still does its own
# job in the same motion. Only a click: the wheel and the divider both leave focus alone.
#
# TYPING STANDS THE POINTER DOWN: any key that does something hides the cursor and stops it
# hovering, so a row you left the mouse over cannot compete with the row you are moving the
# selection onto. Any use of the mouse brings it straight back — moving it, clicking it, or
# turning the wheel. A bare modifier is not a keystroke, so holding Alt keeps the cursor up
# to aim an Alt+click with.
mouse: on             # on | off

# Tint the row under the pointer. Deliberately fainter than the selection bar — it says
# "this is what a click would take", not "this is where you are". Needs `mouse: on`, and
# stays off while the pointer is stood down (see above).
hover: on             # on | off

# Which face the filetree pane (Alt+F, `:ls`) wears. BOTH drive the same listing — the same
# entries, the same marks, the same clipboard, the same Ctrl chords — so this is a choice of
# presentation, not of capability, and nothing you can do in one is missing from the other.
#
#   ls        the dired-style listing Slopd has always had: mode, name, size, mtime.
#   browser   a file manager: a top bar of square buttons [◀] [▶] [⟳], a path bar whose
#             segments are buttons, a places sidebar, and contents as a list or a grid.
#
# In `browser` the arrows gain the top bar's chords — ^Left / ^Right walk the history, ^r
# reloads, ^g flips list/grid, ^1..^9 open the sidebar's shortcuts — and Backspace goes up a
# directory. In a GRID, Left/Right step a tile instead of leaving the folder, so Backspace is
# the way out. Everything else is identical to the listing.
file_pane: browser         # ls | browser

# The browser's contents. Not a zoom: the grid/list choice is this line, and `font_size` (or
# Ctrl +/-) scales whichever one is up — a tile is measured in text cells, so it grows with the
# font. The pane's own toggle button writes this line back, so the view survives a restart.
file_view: list       # list | grid

# Per-type icons in the browser — a folder, a Rust file, an archive. They are GLYPHS from a
# second embedded face (Nerd Fonts' Seti-UI + Devicons, ~178KB subset beside the ~222KB text
# font), so they cost no image decode and no cache: the icon says the TYPE and the colour still
# says the state (directory, executable, unsaved). Turn them off and the rows lose the column
# entirely rather than keeping a blank one. Inert if the build vendored no icon face — see
# download-deps.sh, which needs python3-fonttools for it.
file_icons: on        # on | off

# The file browser's Ctrl chords, all of which also work in the `ls` listing:
#   ^y mark / unmark the entry     ^u clear every mark
#   ^c copy      ^x cut            ^v paste into the folder you are browsing
#   ^d delete the entry            ^D delete the whole marked set   (both stage an `rm -rf`
#                                     in the command line — you read it and press Enter)
#   ^w copy the entry's path       ^W copy the browsed folder's path
# Copy and cut fill a clipboard from the marked set, or from the row under the cursor when
# nothing is marked; paste applies it here. A cut is spent by its paste, a copy is not. Hold
# Ctrl to see the lot along the bottom of the pane. RIGHT-CLICK for the same list as buttons.

# The file browser's places sidebar. One `Name: /path` per line, in sidebar order. This block
# is DATA, not settings: everything below a [section] header is out of the key/value space the
# Config pane (`cf`) edits, and no setting is ever read or written past this line.
#
# Right-click a folder in the browser to add or remove one, which rewrites this block. Delete
# the block entirely and Slopd fills it back in with your home directory, whichever of the
# standard folders under it exist, and the filesystem root.
#
# [places]
# Home: /home/you
# Projects: /home/you/src

# Key bindings. One `chord: action` per line, over the defaults; `none` (or an empty value)
# unbinds one. Edit them in the binds pane (`:binds`, or the Config pane's `bindings` row) or
# with `:rebind [+|-|N] <action> [chord]` — a line this file gets wrong is reported there and
# blocks any write-back.
#
#   chord    ctrl / alt / shift, then the key: `alt+f`, `ctrl+shift+z`, `alt+[`, `f5`, `kp_add`.
#            The key is PHYSICAL, so `alt+;` is a different glyph on a different layout.
#   action   `file.mark`, `edit.save`, `nav.down` … the prefix is the subject.
#
# Shift is not usually written: a Shift chord that matches nothing retries without it and the
# action EXTENDS, which is what makes Shift+Down sweep marks and ^Shift+D take the marked set.
#
# Two rules a line can break. A bare printable key cannot run a `edit.*` or `nav.*` action —
# it would stop that letter typing. And one chord means one thing per context, so a second
# line claiming it is refused rather than silently losing.
#
# [binds]
# alt+f: pane.grep
# ctrl+y: none
