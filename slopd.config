# Slopd config — simple `key: value`, '#' comments.
# `theme` points at a theme file in Prawk's .theme format. The name is arbitrary;
# a relative path resolves against this config file's directory.
theme: themes/default.theme

indent: spaces4       # tab | spaces2 | spaces4 | spaces8 ...
line_numbers: global  # global | relative
jump_lines: 10        # lines Ctrl+Up/Down jumps in the editor

# How every line view tracks what it follows — the editor its caret, and the filetree /
# procmon / grep / config / git sidebar lists their selection. follow: the view sits still
# until the target would leave it, then moves the minimum. middle: the target is pinned to
# the pane's middle row, so Up/Down always move the CONTENT under a fixed row (clamped at
# the top — there is nothing above row 0 to show). In the editor, "the target" is the FIRST
# (topmost) cursor.
scroll_mode: follow   # follow | middle

# Editor reading-aids (all default on; toggle in the Config pane too).
whitespace: on        # on | off — ghost leading-space dots / tab marks
indent_guides: on     # on | off — indent guides + the active-scope rail
folding: on           # on | off — Ctrl+Enter collapses blocks

# Command-line staging: a UI action that builds a CL command can stage it (you review
# and press Enter) or run it immediately.
folder_cd: stage      # stage | run — filetree Alt+Enter on a folder: cd to set the root
git_checkout: stage   # stage | run — git branch-strip Enter: checkout the hovered branch
git_commit: stage     # stage | run — git commit box Enter: commit the checked hunks
git_merge: stage      # stage | run — git branch-strip Space / merge finish + abort

# When the open file changes on disk while you have unsaved edits. prompt: stage a `reload`
# command in the command line — finish it with `reload y` (re-read, lose edits) or `reload n`
# (keep mine, stop asking until it changes again). keep: the relaxed mode — silently keep your
# edits, no prompt. (A clean buffer always auto-reloads either way.)
disk_conflict: prompt  # prompt | keep

# Pointer input. Additive only — everything the mouse reaches has a key binding, so `off`
# costs convenience and never capability. The wheel scrolls whatever is UNDER the cursor,
# focused or not, and never moves focus:
#   editor    the view, freely — scrolling DETACHES it from the caret (in both scroll_modes)
#             and the next keystroke re-attaches, snapping back to wherever you were typing
#   terminal  the scrollback copy cursor — or the full-screen TUI's own scroll, if one is up
#   git       the sidebar list on the left, the diff on the right
#   lists     filetree / grep / config / procmon: the view, detaching from the selection
#             exactly as the editor detaches from the caret. The next keystroke in that pane
#             re-attaches and the list jumps back to whatever is selected.
#   procmon   as above over the list; over the graph band, nothing (a graph is a picture,
#             not a viewport), except while the signal selector is up, where it walks the grid
mouse: on             # on | off

# Tint the row under the pointer. Deliberately fainter than the selection bar — it says
# "this is what a click would take", not "this is where you are". Needs `mouse: on`.
hover: on             # on | off
