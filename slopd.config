# Slopd config — simple `key: value`, '#' comments. A '#' starts a comment at the start of
# a line or after a space; glued to text (`foo#bar`) it is just part of the value. Editing a
# setting from the Config pane (`cf`) rewrites its line here and leaves its comment alone.
#
# THIS FILE LIVES BESIDE THE BINARY, and so does everything else Slopd owns: themes/,
# grammars/, perf.log. There is no search path, no ~/.config/slopd, and no setting here can
# point outside that one directory. Move the binary and its whole world moves with it.
#
# `theme` is a NAME, never a path: `default` is the Gruvbox palette baked into the binary,
# and any other name is themes/<name>.theme next to it, a folder YOU create and drop
# .theme files (Prawk's format) into. It ships empty because the default is already inside
# the binary. A value with a '/' in it is refused, and the default stands.
theme: default

indent: spaces4       # tab | spaces2 | spaces4 | spaces8 ...
line_numbers: global  # global | relative
jump_lines: 10        # lines Ctrl+Up/Down jumps in the editor

# How every line view tracks what it follows — the editor its caret, and the filetree /
# grep / config lists their selection. follow: the view sits still
# until the target would leave it, then moves the minimum. middle: the target is pinned to
# the pane's middle row, so Up/Down always move the CONTENT under a fixed row (clamped at
# the top — there is nothing above row 0 to show). In the editor, "the target" is the FIRST
# (topmost) cursor.
scroll_mode: follow   # follow | middle

# Editor reading-aids (all default on; toggle in the Config pane too).
whitespace: on        # on | off — ghost leading-space dots / tab marks
indent_guides: on     # on | off — indent guides + the active-scope rail
folding: on           # on | off — Ctrl+Enter collapses blocks

# Command-line staging: a UI action that builds a CL command can stage it (you review
# and press Enter) or run it immediately.
folder_cd: stage      # stage | run — filetree Alt+Enter on a folder: cd to set the root

# Git. Slopd has no git pane: Alt+G (or the `gs` command) hands the project root to
# whatever tool you already use, as its last argument. Unset, Alt+G opens a plain shell
# at the root instead.
#
# git_term decides where it runs, because the two kinds of tool want opposite things:
#   unset / 0   spawn it DETACHED, with its own window and no terminal — for a GUI
#               (sublime_merge, gitkraken, gitg). It outlives Slopd.
#   a number    run it in that terminal session — for a TUI (lazygit, tig, gitui), which
#               wants a PTY and a pane to live in. A number past the last open session
#               opens the next one: ask for 8 with three open and you get the fourth.
#
# In the Config pane git_tool is a TEXT field — highlight the row and type; Enter (or moving
# off the row) saves it. git_term is a dropdown of the sessions a launch can reach, and writes
# `detached` where this file leaves the value empty.
#
# One limit on the text field: a '#' after a space starts a comment in this file, so the pane
# refuses a value containing one rather than saving something that would read back truncated.
# `foo#bar` (glued, no space) is fine — that '#' is part of the value.
git_tool:             # e.g. lazygit — or `sublime_merge -n`, flags and all
git_term:             # e.g. 2 — empty (or `detached`) spawns it detached

# When the open file changes on disk while you have unsaved edits. prompt: stage a `reload`
# command in the command line — finish it with `reload y` (re-read, lose edits) or `reload n`
# (keep mine, stop asking until it changes again). keep: the relaxed mode — silently keep your
# edits, no prompt. (A clean buffer always auto-reloads either way.)
disk_conflict: prompt  # prompt | keep

# Pointer input. Additive only — everything the mouse reaches has a key binding, so `off`
# costs convenience and never capability. The wheel scrolls whatever is UNDER the cursor,
# focused or not, and it never moves focus:
#   editor    the view, freely — scrolling DETACHES it from the caret (in both scroll_modes)
#             and the next keystroke re-attaches, snapping back to wherever you were typing
#   terminal  the view, the same way. A wheel never moves the copy cursor. If the program
#             running in it asked for the mouse, or took the full screen, the notch is ITS
#             scroll instead — hold Shift to keep it local and scroll our scrollback.
#   image     zoom, about the pointer: the pixel under the cursor stays under the cursor
#   lists     filetree / grep / config: the view, detaching from the selection
#             exactly as the editor detaches from the caret. The next keystroke in that pane
#             re-attaches and the list jumps back to whatever is selected.
#
# Clicks. In the editor: click places the caret, Shift+click extends, Alt+click drops a
# cursor, double-click takes the word, triple-click the line, and a click on a fold's ...
# marker expands it. In a list: click selects, double-click opens. In a terminal: the same
# three grades of selection, unless the program asked for the mouse, in which case the click
# is forwarded to it — Shift keeps it local. A bare modifier is not a keystroke, so holding
# Alt leaves the cursor on screen to aim with.
#
# Dragging. Press and drag extends a selection by whatever the press chose (character, word
# or line), and keeps extending past the edge of the pane, scrolling as it goes. Drag the
# 2px divider between the panes to resize the split; a click on it does nothing. Drag an
# image to pan it, and double-click one to fit it back into the pane.
#
# CLICKING A PANE FOCUSES IT — the arrows follow your click, and the click still does its own
# job in the same motion. Only a click: the wheel and the divider both leave focus alone.
#
# TYPING STANDS THE POINTER DOWN: any key that does something hides the cursor and stops it
# hovering, so a row you left the mouse over cannot compete with the row you are moving the
# selection onto. Any use of the mouse brings it straight back — moving it, clicking it, or
# turning the wheel. A bare modifier is not a keystroke, so holding Alt keeps the cursor up
# to aim an Alt+click with.
mouse: on             # on | off

# Tint the row under the pointer. Deliberately fainter than the selection bar — it says
# "this is what a click would take", not "this is where you are". Needs `mouse: on`, and
# stays off while the pointer is stood down (see above).
hover: on             # on | off
