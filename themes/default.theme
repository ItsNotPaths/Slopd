# Gruvbox Material Dark — sourced from sainnhe's Sublime Text scheme
# (Gruvbox Material Theme.sublime-package -> Gruvbox Material Dark.sublime-color-scheme)
# Prawk-compatible: `key: #rrggbb`, '#' comments, unknown keys ignored.
bg:            #292828
fg:            #d4be98
accent:        #9253be
muted:         #928374
urgent:        #ea6962
border_light:  #504945
border_dark:   #32302f
separator:     #45403d
# Source scheme uses alpha: selection = grey5 #504945 @ b0, line_highlight (the
# current-line bar) = grey7 #383432 @ 90 — pre-blended over bg here (opaque fills).
selection:     #443f3c
line_highlight: #322f2e
code_keyword:  #d3869b
code_string:   #d8a657
code_comment:  #928374
code_number:   #d3869b
code_operator: #e78a4e
code_type:        #a9b665
code_return_type: #89b482
cl_inject:        #ff0000

# Slopd extensions (for tree-sitter), same Gruvbox Material source. Prawk ignores
# these; Slopd uses them when syntax highlighting lands.
code_function:    #a9b665
code_variable:    #d4be98
code_constant:    #d3869b
code_punctuation: #928374

# Editor guides — kept subtle so they sit behind the code without competing with it.
# whitespace: the ghosted leading-space dots / tab marks. indent_guide: the per-level
# vertical rail. indent_guide_active: the rail of the scope the cursor sits in — a
# dimmed accent (the gruvbox purple) so the current block reads at a glance.
whitespace:           #3a3735
indent_guide:         #3a3735
indent_guide_active:  #63407b
